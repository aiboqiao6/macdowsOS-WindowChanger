# Share one guarded ABI translation between the research host and the shipped
# profile. Any drift in the source identities or expected entry points is a
# configure error, rather than a partially translated runtime.
function(office_21048_sources output root_directory seed)
    set(profile_dir "${root_directory}/research/framework-probe")
    set(files office.cpp office-layout.h office-lease.h office-edit-title.h)
    set(digest "${seed}")
    foreach(name IN LISTS files ITEMS office-21048-verify.h)
        set(path "${profile_dir}/${name}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(SHA256 "${path}" part)
        string(APPEND digest "${part}")
    endforeach()
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" part)
    string(SHA256 digest "${digest}${part}")
    string(SUBSTRING "${digest}" 0 12 digest)
    set(destination "${CMAKE_BINARY_DIR}/office-21048-source/${digest}")
    set(rvas
        0x49c30:0x49ee0 0x484c0:0x48770 0x285fa0:0x289330 0x4ab00:0x4adb0
        0x135480:0x135690 0x9cba0:0x9cdb0 0xb82a0:0xb84b0 0xe4580:0xe4790
        0x100420:0x100630 0x170340:0x170500 0x1c1180:0x1c1390 0x72808:0x72a18)
    foreach(name IN LISTS files)
        file(READ "${profile_dir}/${name}" source)
        foreach(mapping IN LISTS rvas)
            string(REPLACE ":" ";" pair "${mapping}")
            list(GET pair 0 before)
            list(GET pair 1 after)
            if(source MATCHES "${before}([^0-9a-fA-F]|$)")
                set(found_${before} TRUE)
            endif()
            string(REGEX REPLACE "${before}([^0-9a-fA-F]|$)" "${after}\\1" source "${source}")
        endforeach()
        if(name STREQUAL "office.cpp")
            set(identities
                "0x2d264595, 0x7ea8, 0x4318, {0x8a, 0xa1, 0x89, 0x76, 0x91, 0xf9, 0xd8, 0xee}|0x3e4b8c5a, 0xb16a, 0x4de5, {0xb0, 0x63, 0x33, 0x8e, 0xdf, 0x2b, 0xb5, 0x46}"
                "0x7da1c564, 0x0bee, 0x44f1, {0x83, 0x3b, 0x50, 0x36, 0x83, 0x82, 0x11, 0xd4}|0x587d5bed, 0x5243, 0x4e42, {0x9e, 0x0e, 0x87, 0xc8, 0x7c, 0x6a, 0x4e, 0x20}"
                "0x609d7177, 0x47d3, 0x4508, {0xb5, 0x9d, 0xab, 0x1f, 0xd4, 0xfb, 0x16, 0x24}|0x6ff021ed, 0x7c7b, 0x4196, {0xbc, 0x82, 0x49, 0xf0, 0x56, 0xff, 0x3c, 0xf8}")
            foreach(mapping IN LISTS identities)
                string(REPLACE "|" ";" pair "${mapping}")
                list(GET pair 0 before)
                list(GET pair 1 after)
                string(FIND "${source}" "${before}" position)
                if(position LESS 0)
                    message(FATAL_ERROR "Office ABI source identity changed: ${before}")
                endif()
                string(REPLACE "${before}" "${after}" source "${source}")
            endforeach()
            string(FIND "${source}" "bool Runtime() {" position)
            if(position LESS 0)
                message(FATAL_ERROR "Office ABI verification entry changed")
            endif()
            string(REPLACE "bool Runtime() {" "bool Runtime() {\n    if (!Office21048VerifyLoaded()) return false;" source "${source}")
            set(source "#include \"${profile_dir}/office-21048-verify.h\"\n${source}")
        endif()
        string(REPLACE "#include \"../../" "#include \"${root_directory}/" source "${source}")
        file(GENERATE OUTPUT "${destination}/${name}" CONTENT "${source}")
    endforeach()
    foreach(mapping IN LISTS rvas)
        string(REPLACE ":" ";" pair "${mapping}")
        list(GET pair 0 before)
        if(NOT found_${before})
            message(FATAL_ERROR "Office ABI source entry changed: ${before}")
        endif()
    endforeach()
    set(${output} "${destination}" PARENT_SCOPE)
endfunction()
